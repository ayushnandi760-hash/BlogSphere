# ============================================================
# BlogSphere Root .gitignore
# ============================================================

# ===========
# Backend (Spring Boot / Maven)
# ===========
backend/target/
backend/.mvn/
backend/*.jar
backend/*.war
backend/.classpath
backend/.project
backend/.settings/
backend/bin/

# Spring Boot application properties with secrets (use env vars instead)
# backend/src/main/resources/application-prod.properties

# ===========
# Frontend (Vite / Node.js)
# ===========
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Environment variable files (NEVER commit .env files)
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# ===========
# IDEs & Editors
# ===========
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.code-workspace

# ===========
# OS Generated Files
# ===========
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ===========
# Logs
# ===========
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
