# ============================================================
# BlogSphere Frontend — Environment Variables Template
# ============================================================
# Copy this file to .env.local for local development, or
# add these variables directly to your Vercel project settings
# for production deployments.
# ============================================================

# Base URL of the backend API (Spring Boot on Render).
# For local development, leave this blank — Vite proxy handles it.
# For production on Vercel, set this to your Render backend URL:
VITE_API_BASE_URL=https://blogsphere-api.onrender.com/api
